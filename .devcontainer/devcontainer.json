// Node runs in this container, so node_modules never lands in the repo folder:
// the folder is a notes vault whose indexer reads every file.
{
  "name": "basis",
  "image": "ghcr.io/matta-kelly/basis-dev:main",
  // The CLI inspects the image before it starts the container, and pulls only when the inspect fails: a tag
  // it has stays. So pull it here, on the host, before the CLI resolves the image, for VS Code and `just`
  // alike. A failed pull does not fail the start: it says so, and the machine's copy is used.
  // Then the workspace's own network (and its pod, when the repo has .devcontainer/pod.yaml), which the
  // container joins below: scripts/workspace.sh, from kinetic's template.
  "initializeCommand": "(podman pull ghcr.io/matta-kelly/basis-dev:main || echo 'could not pull ghcr.io/matta-kelly/basis-dev:main: the copy this machine has is used' >&2) && scripts/workspace.sh up ${localWorkspaceFolder}",

  // Mount the repo at its host path, so absolute paths in caches and tool output
  // mean the same thing inside the container and out.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",

  // keep-id: map your host user onto the image's `node` user (uid 1000), so files
  // written into the repo from inside stay owned by you. The CPU budget bounds this
  // checkout's container: 3 CPUs, and its shares when the host is contended.
  "runArgs": [
    "--userns=keep-id:uid=1000,gid=1000",
    "--network",
    "basis-${localWorkspaceFolderBasename}",
    "--network-alias",
    "basis-${localWorkspaceFolderBasename}-app",
    "--security-opt",
    "label=disable",
    "--cpus=3",
    "--cpu-shares=256"
  ],
  "remoteUser": "node",
  "updateRemoteUserUID": false,

  // Packages live in a podman volume, not the repo folder: one per checkout, so a worktree has its own.
  // The CLI names it with its id for this folder, so `just` and VS Code mount the same one.
  "mounts": [
    "source=basis-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],

  // A new volume starts root-owned: hand it to `node`, then install. The install reads the image's cache:
  // the image points npm at it and sets npm_config_prefer_offline=true.
  "postCreateCommand": "sudo chown node:node node_modules && npm ci",

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
