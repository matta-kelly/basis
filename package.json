{
  "name": "@mku1tra/basis",
  "version": "0.27.0",
  "description": "The root package for semantic subgraphs: the primitives, the compiler and the lint core that every subgraph imports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matta-kelly/basis.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "@mku1tra/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "basis": "./dist/bin.js"
  },
  "files": [
    "dist",
    "types",
    "!types/basis.config.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "it",
    "basis-notes"
  ]
}
